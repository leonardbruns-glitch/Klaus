{
  "schema_version": 2,
  "description": "Shadow market observation engine — Phase 2. Field catalog. Adding a new field requires (a) appending here AND (b) emitting in the corresponding sampler. Removing a field is forbidden — leave nullable. Phase 2 adds: hold_path record type (per-second trajectory of virtual positions) and regime tags on market_timeline.",
  "record_types": {
    "market_timeline": {
      "doc": "One row per (token_id, second) when token is in eligibility band. Read-only over feed caches.",
      "key": ["token_id", "ts_s"],
      "fields": [
        {"name": "schema_version",        "type": "int8",    "doc": "monotonic — never reused"},
        {"name": "record_type",           "type": "string",  "doc": "literal 'market_timeline'"},
        {"name": "ts_s",                  "type": "int64",   "doc": "unix epoch seconds"},
        {"name": "ts_ms_local",           "type": "int64",   "doc": "millisecond-precision local receive time; directive #4"},
        {"name": "token_id",              "type": "string"},
        {"name": "condition_id",          "type": "string"},
        {"name": "asset",                 "type": "string",  "doc": "BTC|ETH|SOL"},
        {"name": "outcome_dir",           "type": "string",  "doc": "up|down — from market title"},
        {"name": "outcome_side",          "type": "string",  "doc": "YES|NO"},
        {"name": "window_end_ts",         "type": "int64"},
        {"name": "window_size_s",         "type": "int16",   "doc": "300 for 5m"},
        {"name": "seconds_to_resolution", "type": "float32",  "doc": "first-class stored field; never derived at query time"},
        {"name": "weekday",               "type": "int8",    "doc": "0=Mon..6=Sun"},
        {"name": "hour_utc",              "type": "int8"},
        {"name": "minute_utc",            "type": "int8"},
        {"name": "session_bucket",        "type": "string",  "doc": "asia|ldn_open|eu_overlap|ny_pre|ny_open|ny_lunch|power_hour|after_hours"},
        {"name": "best_bid",              "type": "float32"},
        {"name": "best_ask",              "type": "float32"},
        {"name": "mid",                   "type": "float32"},
        {"name": "spread_abs",            "type": "float32"},
        {"name": "spread_bps",            "type": "float32"},
        {"name": "ob_top1_bid_size",      "type": "float32"},
        {"name": "ob_top1_ask_size",      "type": "float32"},
        {"name": "ob_imb_top3",           "type": "float32",  "doc": "(b3-a3)/(b3+a3)"},
        {"name": "ob_book_depth_size",    "type": "float32",  "doc": "b3+a3"},
        {"name": "ob_levels_bid",         "type": "int8"},
        {"name": "ob_levels_ask",         "type": "int8"},
        {"name": "ob_quote_age_ms",       "type": "int32"},
        {"name": "tok_snap_30s",          "type": "float32",  "doc": "% change of token ask vs 30s ago"},
        {"name": "tok_snap_60s",          "type": "float32"},
        {"name": "tok_history_seconds",   "type": "int16"},
        {"name": "binance_spot",          "type": "float32"},
        {"name": "binance_ret_30s_pct",   "type": "float32"},
        {"name": "binance_ret_60s_pct",   "type": "float32"},
        {"name": "binance_ret_5m_pct",    "type": "float32"},
        {"name": "peer_token_id",         "type": "string",   "doc": "sister YES↔NO token of same condition_id; '' if not yet discovered"},
        {"name": "peer_bid",              "type": "float32",  "doc": "best bid of peer token; 0.0 if peer OB unavailable"},
        {"name": "peer_ask",              "type": "float32",  "doc": "best ask of peer token; 0.0 if peer OB unavailable"},
        {"name": "peer_age_ms",           "type": "int32",    "doc": "staleness of peer's OB at sample time"},
        {"name": "arb_sum_yes_no",        "type": "float32",  "doc": "best_ask + peer_ask; 1.0 = no arb signal, deviation = pricing inefficiency"},
        {"name": "vol_regime",             "type": "string",   "doc": "calm|normal|volatile|extreme — bucketed from abs(binance_ret_5m_pct); Phase 2"},
        {"name": "trend_regime",           "type": "string",   "doc": "up|down|flat — from binance_ret_60s_pct; Phase 2"},
        {"name": "liquidity_regime",       "type": "string",   "doc": "thin|normal|deep — from ob_book_depth_size; Phase 2"},
        {"name": "macro_event_window",     "type": "bool",     "doc": "true ±15min of CPI/NFP/FOMC; placeholder false until macro calendar wired; Phase 2"}
      ]
    },
    "gate_trace": {
      "doc": "Phase-1 PASSIVE reconstruction of a stripped-down gate set; not the live strategy trace. Strategy version stamped so future analyses can scope.",
      "key": ["token_id", "ts_s"],
      "fields": [
        {"name": "schema_version",        "type": "int8"},
        {"name": "record_type",           "type": "string"},
        {"name": "ts_s",                  "type": "int64"},
        {"name": "ts_ms_local",           "type": "int64",    "doc": "millisecond-precision local receive time; directive #4"},
        {"name": "token_id",              "type": "string"},
        {"name": "condition_id",          "type": "string"},
        {"name": "asset",                 "type": "string"},
        {"name": "outcome_dir",           "type": "string"},
        {"name": "outcome_side",          "type": "string"},
        {"name": "window_end_ts",         "type": "int64"},
        {"name": "seconds_to_resolution", "type": "float32",  "doc": "first-class stored field; never derived at query time"},
        {"name": "ask",                   "type": "float32"},
        {"name": "gate_results",          "type": "map<string,string>", "doc": "name → PASS|FAIL@<value><op><threshold>"},
        {"name": "all_pass",              "type": "bool"},
        {"name": "first_failed_gate",     "type": "string"},
        {"name": "strategy_version",      "type": "string"},
        {"name": "would_take_at_ask",     "type": "bool"}
      ]
    },
    "shadow_telemetry": {
      "doc": "Pipeline self-telemetry; emitted every telemetry_interval_s (default 60s). Rides the same queue as data records — same durability path.",
      "key": ["ts_s"],
      "fields": [
        {"name": "schema_version",        "type": "int8"},
        {"name": "record_type",           "type": "string",  "doc": "literal 'shadow_telemetry'"},
        {"name": "ts_s",                  "type": "int64"},
        {"name": "uptime_s",              "type": "int64"},
        {"name": "queue_depth",           "type": "int32"},
        {"name": "queue_max",             "type": "int32"},
        {"name": "queue_pct_full",        "type": "float32"},
        {"name": "written_total",         "type": "int64"},
        {"name": "dropped_total",         "type": "int64", "doc": "ANY non-zero is a hard validation-gate failure"},
        {"name": "rows_per_min",          "type": "float32"},
        {"name": "flush_count",           "type": "int64"},
        {"name": "flush_latency_p50_ms",  "type": "float32"},
        {"name": "flush_latency_p95_ms",  "type": "float32"},
        {"name": "rss_mb",                "type": "float32",  "doc": "process RSS via /proc/PID/status"},
        {"name": "files",                 "type": "map<string,struct<path: string, size_bytes: int64>>"}
      ]
    },
    "token_trade": {
      "doc": "Polymarket CLOB last_trade_price events for tracked updown tokens. Captures aggressor side when reported and exchange ts when present in payload. Real-time only — Polymarket does not expose comprehensive historical trade tape, so this stream is irrecoverable later.",
      "key": ["token_id", "ts_ms_local"],
      "fields": [
        {"name": "schema_version",        "type": "int8"},
        {"name": "record_type",           "type": "string",  "doc": "literal 'token_trade'"},
        {"name": "ts_s",                  "type": "int64"},
        {"name": "ts_ms_local",           "type": "int64",   "doc": "ms-precision local receive time"},
        {"name": "exchange_ts_ms",        "type": "int64",   "doc": "Polymarket exchange timestamp from payload (best-effort across timestamp/t/ts/T fields); 0 if absent"},
        {"name": "token_id",              "type": "string"},
        {"name": "condition_id",          "type": "string"},
        {"name": "asset",                 "type": "string"},
        {"name": "outcome_dir",           "type": "string"},
        {"name": "outcome_side",          "type": "string"},
        {"name": "window_end_ts",         "type": "int64"},
        {"name": "seconds_to_resolution", "type": "float32"},
        {"name": "price",                 "type": "float32"},
        {"name": "size",                  "type": "float32"},
        {"name": "side",                  "type": "string",  "doc": "taker direction if reported (BUY/SELL); '' if absent"}
      ]
    },
    "binance_trade": {
      "doc": "Binance USDT-perp aggTrade tape for BTC/ETH/SOL. Sub-second order flow source for VPIN, sweep detection, lead/lag vs Polymarket. Backfillable in principle via Binance /aggTrades endpoint but rate-limited at scale, so persisted live.",
      "key": ["asset", "exchange_ts_ms"],
      "fields": [
        {"name": "schema_version",        "type": "int8"},
        {"name": "record_type",           "type": "string",  "doc": "literal 'binance_trade'"},
        {"name": "ts_s",                  "type": "int64"},
        {"name": "ts_ms_local",           "type": "int64",   "doc": "ms-precision local receive time"},
        {"name": "exchange_ts_ms",        "type": "int64",   "doc": "Binance T field — exchange trade-time ms"},
        {"name": "asset",                 "type": "string",  "doc": "BTC|ETH|SOL"},
        {"name": "price",                 "type": "float32"},
        {"name": "qty",                   "type": "float32"},
        {"name": "is_buyer_maker",        "type": "bool",    "doc": "Binance m field; true → buyer was maker → taker=SELL"},
        {"name": "taker_side",            "type": "string",  "doc": "BUY|SELL — derived from is_buyer_maker for query convenience"}
      ]
    },
    "window_resolution": {
      "doc": "One row per (condition_id, window_end_ts). Resolution from Binance 5m kline open vs close — same 300s grid as the Chainlink oracle.",
      "key": ["condition_id", "window_end_ts"],
      "fields": [
        {"name": "schema_version",        "type": "int8"},
        {"name": "record_type",           "type": "string"},
        {"name": "ts_resolved_s",         "type": "int64"},
        {"name": "condition_id",          "type": "string"},
        {"name": "asset",                 "type": "string"},
        {"name": "outcome_dir",           "type": "string"},
        {"name": "window_end_ts",         "type": "int64"},
        {"name": "window_size_s",         "type": "int16"},
        {"name": "binance_open_5m",       "type": "float32"},
        {"name": "binance_close_5m",      "type": "float32"},
        {"name": "binance_high_5m",       "type": "float32"},
        {"name": "binance_low_5m",        "type": "float32"},
        {"name": "realized_move_pct",     "type": "float32"},
        {"name": "moved_up",              "type": "bool",     "doc": "kline close>=open"},
        {"name": "resolved_yes",          "type": "bool",     "doc": "moved_up XOR (outcome_dir==down)"},
        {"name": "resolution_method",     "type": "string",   "doc": "e.g. 'kline:67200.00->67342.10'"},
        {"name": "resolution_delay_s",    "type": "int32",    "doc": "ts_resolved_s - window_end_ts"},
        {"name": "resolution_source",     "type": "string",   "doc": "literal 'binance_kline'"}
      ]
    },
    "hold_path": {
      "doc": "One row per (virtual_position, second). Virtual position opens at first gate_trace.all_pass=True per (token_id, window_end_ts); rows emitted every second until window closes. Key substrate for Phase-2 trajectory analysis: MAE/MFE evolution, drawdown velocity, imbalance collapse, liquidity decay, divergence vs Binance.",
      "key": ["token_id", "window_end_ts", "ts_s"],
      "fields": [
        {"name": "schema_version",        "type": "int8",     "doc": "2 — Phase 2 record type"},
        {"name": "record_type",           "type": "string",   "doc": "literal 'hold_path'"},
        {"name": "ts_s",                  "type": "int64"},
        {"name": "ts_ms_local",           "type": "int64"},
        {"name": "token_id",              "type": "string"},
        {"name": "condition_id",          "type": "string"},
        {"name": "asset",                 "type": "string"},
        {"name": "outcome_dir",           "type": "string"},
        {"name": "outcome_side",          "type": "string"},
        {"name": "window_end_ts",         "type": "int64"},
        {"name": "seconds_to_resolution", "type": "float32"},
        {"name": "fire_ask",              "type": "float32",  "doc": "best_ask at virtual entry (first all_pass tick)"},
        {"name": "fire_ts_s",             "type": "int64",    "doc": "unix second of virtual entry"},
        {"name": "fire_sec_to_res",       "type": "float32",  "doc": "seconds_to_resolution at virtual entry"},
        {"name": "seconds_held",          "type": "int32",    "doc": "ts_s - fire_ts_s"},
        {"name": "bid",                   "type": "float32"},
        {"name": "ask",                   "type": "float32"},
        {"name": "mid",                   "type": "float32"},
        {"name": "spread_abs",            "type": "float32"},
        {"name": "pnl_pct",              "type": "float32",  "doc": "(bid - fire_ask) / fire_ask * 100"},
        {"name": "mae",                   "type": "float32",  "doc": "running min of pnl_pct since fire — max adverse excursion"},
        {"name": "mfe",                   "type": "float32",  "doc": "running max of pnl_pct since fire — max favourable excursion"},
        {"name": "bid_velocity_1s",       "type": "float32",  "doc": "bid - prev_bid; negative = dropping"},
        {"name": "ob_imb_top3",           "type": "float32"},
        {"name": "ob_book_depth_size",    "type": "float32"},
        {"name": "ob_depth_delta_1s",     "type": "float32",  "doc": "ob_book_depth_size - prev_depth; negative = liquidity leaving"},
        {"name": "ob_quote_age_ms",       "type": "int32"},
        {"name": "binance_spot",          "type": "float32"},
        {"name": "binance_ret_5m_pct",    "type": "float32"},
        {"name": "binance_ret_60s_pct",   "type": "float32"},
        {"name": "session_bucket",        "type": "string"},
        {"name": "hour_utc",              "type": "int8"},
        {"name": "weekday",               "type": "int8"},
        {"name": "vol_regime",            "type": "string"},
        {"name": "trend_regime",          "type": "string"},
        {"name": "liquidity_regime",      "type": "string"}
      ]
    },
    "exit_policy_shadow": {
      "doc": "One row per (first_fire, policy_id). First_fire = gate_trace.all_pass=True deduped per (token_id, window_end_ts). Triggers: PT (bid >= threshold), FALLBACK_30s (hold>=30s), BE_TRAIL (trail-stop after MFE arm), WINDOW_END (rem<=5s backstop). Validation criteria for live swap (per 2026-05-08 audit Deliverable 3): n>=500 fires, >=5 days, every regime quartile n>=40, realistic_pnl_pct mean>=+1.0%, worst quartile>=-1.0%, derate(clean-realistic)<=0.5pp, cat-rate (<=-70%)<=2%.",
      "key": ["token_id", "window_end_ts", "policy_id"],
      "fields": [
        {"name": "schema_version",        "type": "int8"},
        {"name": "record_type",           "type": "string",  "doc": "literal 'exit_policy_shadow'"},
        {"name": "ts_s",                  "type": "int64",   "doc": "emit time"},
        {"name": "token_id",              "type": "string"},
        {"name": "condition_id",          "type": "string"},
        {"name": "asset",                 "type": "string"},
        {"name": "outcome_dir",           "type": "string"},
        {"name": "outcome_side",          "type": "string"},
        {"name": "window_end_ts",         "type": "int64"},
        {"name": "fire_ts_s",             "type": "int64",   "doc": "first-fire (gate all_pass) tick"},
        {"name": "fire_ask",              "type": "float32", "doc": "best_ask at first-fire — entry-side reference"},
        {"name": "sec_to_res_at_fire",    "type": "float32"},
        {"name": "policy_id",             "type": "string",  "doc": "PT0.95+30s | PT0.93+30s | BE_trail_5_3"},
        {"name": "exit_ts_s",             "type": "int64"},
        {"name": "exit_bid",              "type": "float32"},
        {"name": "exit_bid_size",         "type": "float32"},
        {"name": "exit_trigger",          "type": "string",  "doc": "PT | FALLBACK_30s | BE_TRAIL | WINDOW_END"},
        {"name": "clean_pnl_pct",         "type": "float32", "doc": "(exit_bid - fire_ask)/fire_ask * 100"},
        {"name": "realistic_pnl_pct",     "type": "float32", "doc": "with bid-evaporation derate vs REF_SHARES=10"},
        {"name": "fill_ok",               "type": "bool",    "doc": "exit_bid_size >= REF_SHARES"},
        {"name": "hold_seconds",          "type": "float32"},
        {"name": "bnc_5m_pct",            "type": "float32", "doc": "regime tag — snapshot at first-fire"},
        {"name": "snap30",                "type": "float32"},
        {"name": "snap60",                "type": "float32"},
        {"name": "hour_utc",              "type": "int8"},
        {"name": "session_bucket",        "type": "string"},
        {"name": "direction",             "type": "string",  "doc": "up|down — copy of outcome_dir for query convenience"}
      ]
    }
  }
}
