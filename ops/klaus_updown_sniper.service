[Unit]
Description=Klaus UPDOWN-SNIPER live executor (BTC 5/15m certainty harvest)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Klaus
Environment=PYTHONPATH=/root/Klaus
Environment=UPDOWN_LIVE=0
EnvironmentFile=-/root/Klaus/.env
ExecStart=/usr/bin/python3 /root/Klaus/strategy/updown_sniper.py
Restart=always
RestartSec=10
MemoryMax=400M

[Install]
WantedBy=multi-user.target
