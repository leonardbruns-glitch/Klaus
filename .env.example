# Klaus Momentum Scalper — environment variables
# Copy to .env and fill in your values (same format as old polymarket-bot)

# Polygon wallet private key (0x...)
PRIVATE_KEY=

# Funder/proxy wallet address (your Polymarket portfolio address)
FUNDER_ADDRESS=

# Signature type: 1 = EOA (standard), 2 = proxy wallet
SIGNATURE_TYPE=1

# Set to "false" to go live — ONLY after dry-run testing
DRY_RUN=true
